# Internal engineering notes: kept on the developer's disk, never pushed (same as
# CLAUDE.md). They describe how and why, and are not for the public repository
# or for client sites. NOTE: ignoring them means they are not backed up by git;
# back them up separately if that matters.
# ---------------------------------------------------------------------------
AGENT.md

# ---------------------------------------------------------------------------
# Test tooling.
#
# PHPUnit and its dependencies live in tests/ with their own composer.json,
# deliberately separate from the theme root's vendor/ — which IS committed,
# because a fresh clone must work with no composer install at all. Keeping
# dev-only packages out of that vendor/ is what makes committing it safe.
# ---------------------------------------------------------------------------
tests/vendor/
# No lock either: the tools resolve for whichever PHP runs them (CI tests 8.2
# and 8.4; a lock made on a newer PHP can't install on an older one).
tests/composer.lock
.phpunit.result.cache

# Machine-specific: contains a local database socket path.
tests/wp-tests-config.php

# Build output
*.zip

# OS and editor cruft
.DS_Store
.vscode/
.idea/
