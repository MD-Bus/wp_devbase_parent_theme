# ---------------------------------------------------------------------------
# AGENT.md files (the internal design notes) ARE version-controlled. They are
# kept out of every release by .gitattributes (export-ignore), so they never
# reach a client site. Check them for secrets and client details before
# committing: they describe how and why, never credentials.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Test tooling.
#
# PHPUnit and its dependencies live in tests/ with their own composer.json,
# deliberately separate from the theme root's vendor/ — which IS committed,
# because a fresh clone must work with no composer install at all. Keeping
# dev-only packages out of that vendor/ is what makes committing it safe.
# ---------------------------------------------------------------------------
tests/vendor/
.phpunit.result.cache

# Machine-specific: contains a local database socket path.
tests/wp-tests-config.php

# Build output
*.zip

# OS and editor cruft
.DS_Store
.vscode/
.idea/
