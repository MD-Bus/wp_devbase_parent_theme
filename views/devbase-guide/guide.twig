{# The Guide (inc/guide/guide.php). Context: site, home, is_admin, version, site_version, tsf, go = { screen: admin address },
   tabs = [ { id, title, url, current } ], tab (the open one, or 'all' for the whole guide), tab_title, today,
   parts = [ { id, title, chapters } ] (one per tab shown: one, or every tab for 'all'),
   chapters = [ { id, title, icon, templates, html } ] (the first part's), all_url (the whole guide, printing), print.
   shot( name, caption ) prints a screenshot from assets/guide/<name>.jpg (the child's first), or nothing when it is missing.
   The PDF is the browser's Save as PDF: .guide-cover shows only in print, the toolbar and the intro only on screen. #}
{% set theme_version = tab == 'site' ? site_version : version %}
<style>
	@page { @bottom-left { content: "{{ site|e('css') }} \2014  Guide"; } }
	@page :first { @bottom-left { content: none; } }
</style>
<div class="guide{{ tab == 'all' ? ' guide--all' }}">
	<div class="guide-bar">
		{% if tabs|length > 1 %}
		<nav class="guide-tabs" aria-label="Guide">
			{% for t in tabs %}
			<a href="{{ t.url }}" class="guide-tabs__tab{{ t.current ? ' is-active' }}"{{ t.current ? ' aria-current="true"' }}>{{ t.title }}</a>
			{% endfor %}
		</nav>
		{% endif %}
		<div class="guide-actions" title="Opens your browser's print window: choose Save as PDF as the destination, then Save.">
			<button type="button" class="guide-btn guide-btn--primary" onclick="devbaseGuidePdf()">
				<svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M10 3v9m0 0-3.5-3.5M10 12l3.5-3.5M4 14v2h12v-2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
				{{ tabs|length > 1 and tab != 'all' ? 'PDF of this tab' : 'Download PDF' }}
			</button>
			{% if all_url and tab != 'all' %}
			<a class="guide-btn" href="{{ all_url }}">
				<svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M5 3.5h7l3 3v10H5z M12 3.5v3h3 M8 10h4 M8 13h4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/></svg>
				PDF of the whole guide
			</a>
			{% endif %}
		</div>
	</div>

	<header class="guide-cover">
		<p class="guide-cover__kicker">Guide</p>
		<h1 class="guide-cover__site">{{ site }}</h1>
		<p class="guide-cover__what">{{ tab == 'all' ? parts|map(p => p.title)|join(' · ') : tab_title }}</p>
		<p class="guide-cover__meta">Theme version {{ theme_version }} · {{ today }}</p>
	</header>

	<div class="guide-intro">
		{% if tab == 'all' %}
		<p class="guide-lead">The whole guide to <strong>{{ site }}</strong>: {% for p in parts %}<strong>{{ p.title }}</strong>{{ not loop.last ? (loop.revindex == 2 ? ' and ' : ', ') }}{% endfor %}.</p>
		{% elseif tab == 'theme' %}
		<p class="guide-lead">The features behind <strong>{{ site }}</strong> that every site built on this theme shares: forms, email, spam protection, images, search engines, speed and updates. Each chapter says where the setting is and what it does.</p>
		{% if not is_admin %}<p class="guide-meta">Some chapters are for administrators only, so you see the ones your account can use.</p>{% endif %}
		{% else %}
		<p class="guide-lead">Everything you need to keep <strong>{{ site }}</strong> up to date, step by step and with pictures of the real screens. Pick a chapter, or read it from the top the first time.</p>
		{% endif %}
		<p class="guide-meta">Written for theme version {{ theme_version }}.</p>
	</div>

	{% for p in parts %}
	<div class="guide-part" id="part-{{ p.id }}">
		{% if parts|length > 1 %}<h1 class="guide-part__title">{{ p.title }}</h1>{% endif %}

		<nav class="guide-toc" aria-label="{{ parts|length > 1 ? p.title ~ ': chapters' : 'Chapters' }}">
			<p class="guide-toc__label">Contents</p>
			<ol>
				{% for c in p.chapters %}
				<li><a href="#{{ c.id }}"><span class="dashicons {{ c.icon }}" aria-hidden="true"></span><span class="guide-toc__num">{{ loop.index }}</span><span class="guide-toc__title">{{ c.title }}</span></a></li>
				{% endfor %}
			</ol>
		</nav>

		{% for c in p.chapters %}
		<section class="guide-chapter" id="{{ c.id }}" aria-labelledby="{{ c.id }}-title">
			<h2 id="{{ c.id }}-title"><span class="guide-chapter__num">{{ loop.index }}</span>{{ c.title }}</h2>
			{% if c.templates %}{% include c.templates ignore missing %}{% else %}{{ c.html|raw }}{% endif %}
			<p class="guide-top"><a href="#wpbody">Back to the top ↑</a></p>
		</section>
		{% endfor %}
	</div>
	{% endfor %}
</div>
<script>
	// The PDF is the browser's own "Save as PDF", with the guide's print styles. The screenshots load lazily, so every
	// one is loaded first: a picture still waiting when the print dialog opens would be missing from the PDF.
	function devbaseGuidePdf() {
		var images = Array.prototype.slice.call( document.querySelectorAll( '.guide img' ) );
		images.forEach( function ( img ) { img.loading = 'eager'; } );
		Promise.all( images.map( function ( img ) {
			return img.complete ? null : new Promise( function ( done ) { img.addEventListener( 'load', done ); img.addEventListener( 'error', done ); } );
		} ) ).then( function () { window.print(); } );
	}
	{% if print %}window.addEventListener( 'load', devbaseGuidePdf );{% endif %}
</script>
