<!doctype html>
<html {{ site.language_attributes }}>
<head>
	<meta charset="{{ site.charset }}">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{{ site.name }}</title>
	{{ function('wp_head') }}
	<style>
		:root {
			--bg: #ffffff;
			--ink: #141414;
			--muted: #6b6b70;
			--accent: #1e5eff;
		}

		@media (prefers-color-scheme: dark) {
			:root {
				--bg: #141414;
				--ink: #f4f4f5;
				--muted: #9a9aa0;
			}
		}

		* {
			box-sizing: border-box;
		}

		html, body {
			height: 100%;
		}

		body {
			margin: 0;
			background: var(--bg);
			color: var(--ink);
			font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
			display: flex;
			align-items: center;
			justify-content: center;
			text-align: center;
			padding: 24px;
		}

		.placeholder {
			max-width: 32rem;
		}

		.placeholder img {
			width: 64px;
			height: 64px;
			margin-bottom: 24px;
		}

		.placeholder h1 {
			margin: 0 0 8px;
			font-size: 1.5rem;
			font-weight: 600;
			letter-spacing: -0.01em;
		}

		.placeholder p {
			margin: 0;
			color: var(--muted);
			font-size: 1rem;
			line-height: 1.5;
		}

		.placeholder .accent {
			color: var(--accent);
		}
	</style>
</head>
<body {{ function('body_class') }}>
	{{ function('wp_body_open') }}
	<div class="placeholder">
		{# theme.uri is get_template_directory_uri() (this PARENT theme); theme.link
	   is get_stylesheet_directory_uri(), which resolves to the CHILD theme when
	   one is active and would 404 on this parent-owned icon. #}
		<img src="{{ theme.uri }}/assets/icons/devbase-b-icon.svg" alt="Dev Base" width="64" height="64">
		<h1><span class="accent">Dev</span> Base Theme</h1>
		<p>A parent theme for WordPress development. Build your site in a child theme.</p>
	</div>
	{{ function('wp_footer') }}
</body>
</html>
