{
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org"
        }
    ],
    "require": {
        "wpackagist-plugin/woocommerce": "11.2.2",
        "wpackagist-plugin/wpvivid-backuprestore": "0.9.138"
    },
    "extra": {
        "installer-paths": {
            ".build/{$name}/": [
                "type:wordpress-plugin"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        },
        "vendor-dir": ".build/vendor"
    }
}
