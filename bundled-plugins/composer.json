{
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.wp-packages.org"
        }
    ],
    "require": {
        "wp-plugin/woocommerce": "11.3.0",
        "wp-plugin/wpvivid-backuprestore": "0.9.140"
    },
    "extra": {
        "installer-paths": {
            ".build/{$name}/": [
                "type:wordpress-plugin"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        },
        "vendor-dir": ".build/vendor"
    }
}
