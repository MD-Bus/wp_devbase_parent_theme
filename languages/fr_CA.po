msgstr "1 jour"

msgid "1 Week"
msgstr "1 semaine"

msgid "1 Month"
msgstr "1 mois"

msgid "3 Months"
msgstr "3 mois"

msgid "6 Months"
msgstr "6 mois"

msgid "1 Year"
msgstr "1 an"

msgid "Which registered form(s) this policy purges."
msgstr "Le ou les formulaires enregistrés que cette politique purge."

msgid "Run Purge Now"
msgstr "Purger maintenant"

msgid "Purging…"
msgstr "Purge en cours…"

