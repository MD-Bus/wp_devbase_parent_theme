msgstr "SMTP est désactivé — utilise la fonction mail() par défaut de PHP."

msgid "SMTP is enabled — not tested yet. Use \"Send Test Email\" on SMTP Settings."
msgstr "SMTP est activé — pas encore testé. Utilisez « Envoyer un courriel de test » dans Réglages SMTP."

msgid "SMTP last tested successfully: %s."
msgstr "SMTP testé avec succès pour la dernière fois : %s."

msgid "SMTP last test FAILED (%1$s): %2$s"
msgstr "Échec du dernier test SMTP (%1$s) : %2$s"

msgid "System Status"
msgstr "État du système"

msgid "Form Notifications"
msgstr "Notifications de formulaire"

