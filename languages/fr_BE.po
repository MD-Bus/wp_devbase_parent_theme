msgstr "La dernière vérification a échoué (%s) ; le résultat précédent est affiché."

msgid "Remote setup is not complete: enter the management server address and site access key (Remote setup tab) to receive settings automatically."
msgstr "La configuration à distance n’est pas terminée : saisissez l’adresse du serveur de gestion et la clé d’accès du site (onglet Configuration à distance) pour recevoir les réglages automatiquement."

msgid "Settings are managed remotely. Last updated %s ago."
msgstr "Les réglages sont gérés à distance. Dernière mise à jour il y a %s."

msgid "Settings are managed remotely. Not updated yet."
msgstr "Les réglages sont gérés à distance. Pas encore mis à jour."

msgid "The last update failed (%s); keeping the current values."
msgstr "La dernière mise à jour a échoué (%s) ; les valeurs actuelles sont conservées."

msgid "Remote settings: updated."
msgstr "Réglages à distance : mis à jour."

msgid "Remote settings: update failed (%s)."
msgstr "Réglages à distance : échec de la mise à jour (%s)."

msgid "%s: no licence, so updates are off."
msgstr "%s : aucune licence, les mises à jour sont désactivées."

msgid "%s: could not read the installed version."
msgstr "%s : impossible de lire la version installée."

