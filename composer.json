{
    "repositories": [
        { "type": "composer", "url": "https://wpackagist.org" }
    ],
    "require": {
        "timber/timber": "^2.5",
        "wpackagist-plugin/secure-custom-fields": "6.9.8",
        "wpackagist-plugin/admin-site-enhancements": "9.3.1"
    },
    "extra": {
        "installer-paths": {
            "vendor/{$name}/": ["type:wordpress-plugin"]
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
